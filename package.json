{
  "name": "@nebos1/promptov",
  "version": "0.1.0",
  "description": "A small CLI that turns a vague visual idea into a useful image prompt for AI image generators.",
  "type": "module",
  "bin": {
    "promptov": "cli.js"
  },
  "files": [
    "cli.js",
    "api-client.js",
    "history.js",
    "validation.js",
    "response.js",
    "errors.js",
    "error-handler.js",
    "config.js"
  ],
  "scripts": {
    "start": "node cli.js",
    "test": "node --test",
    "configure-api": "node scripts/configure-api.mjs",
    "prepack": "node scripts/check-release.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "keywords": [
    "ai",
    "prompt",
    "image",
    "generator",
    "cli",
    "visual",
    "idea",
    "text-to-image",
    "prompt-generator",
    "prompt-engineering",
    "creative",
    "artificial-intelligence",
    "image-generation",
    "text-to-image-generation",
    "prompt-creation",
    "image-prompt",
    "text-to-image-prompt",
    "ai-art",
    "ai-image-generation",
    "creative-prompting",
    "visual-prompting",
    "prompt-optimization",
    "image-prompting",
    "text-to-image-creation"
  ],
  "author": "nebos1",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nebos1/promptov.git"
  },
  "homepage": "https://github.com/nebos1/promptov#readme",
  "bugs": {
    "url": "https://github.com/nebos1/promptov/issues"
  }
}
